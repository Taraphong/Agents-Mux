# เลือกผู้ให้บริการ: openai, gemini, anthropic, hf, or, groq
AI_PROVIDER=openai

# OpenAI-compatible API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Anthropic API
# หลังตั้ง AI_PROVIDER=anthropic ให้เลือกโมเดล Claude ในหน้า Settings ด้วย
ANTHROPIC_API_KEY=

# Hugging Face API
HF_API_KEY=
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

# OpenRouter API
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3-haiku-20240307

# Groq API
GROQ_API_KEY=
GROQ_MODEL=mixtral-8x7b-32768

# เปิด scheduler เมื่อรันผ่าน WSGI (ปกติเริ่มอัตโนมัติเมื่อรัน python app.py)
AI_WEB_ENABLE_SCHEDULER=

# เปิดใช้งาน Base URL เฉพาะ (เว้นว่างเพื่อใช้ค่า default ตามผู้ให้บริการ)
AI_BASE_URL=

# ไฟล์ log ระบบแบบถาวร (ค่าเริ่มต้น: logs/app-log.jsonl)
AI_WEB_LOG_FILE=logs/app-log.jsonl

# Web auth แบบจับคู่อุปกรณ์ (ค่าเริ่มต้น: on) — ตั้ง off เฉพาะเครือข่ายที่เชื่อถือได้
# สร้าง Pairing Key ฝั่ง server ด้วย: python app.py --pairing-key
AI_WEB_AUTH=on

# ไฟล์เก็บ hash ของ Pairing Key และ session ที่จับคู่แล้ว (ห้าม commit)
AI_WEB_AUTH_FILE=.app-auth.json

# อายุ Pairing Key (นาที) และอายุ session ของอุปกรณ์ที่จับคู่แล้ว (วัน)
AI_WEB_PAIRING_TTL_MINUTES=30
AI_WEB_SESSION_DAYS=30

# ตั้ง 1 เฉพาะเมื่อมี reverse proxy ที่ terminate TLS (เชื่อถือ X-Forwarded-Proto เพื่อให้คุกกี้เป็น Secure)
AI_WEB_TRUST_PROXY=

