# Choose the provider: openai, gemini, anthropic, hf, or, groq
AI_PROVIDER=openai

# OpenAI-compatible API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Anthropic API
# After setting AI_PROVIDER=anthropic, also select a Claude model in Settings
ANTHROPIC_API_KEY=

# Hugging Face API
HF_API_KEY=
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

# OpenRouter API
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3-haiku-20240307

# Groq API
GROQ_API_KEY=
GROQ_MODEL=mixtral-8x7b-32768

# Enable the scheduler when running under WSGI (normally started automatically when running python app.py)
AI_WEB_ENABLE_SCHEDULER=

# Discord bot (optional). Leave the allowlists empty to allow everyone/every channel.
DISCORD_BOT_TOKEN=
DISCORD_BOT_PREFIX=!ai
# Comma-separated Discord IDs: users allowed to chat with the bot
DISCORD_ALLOWED_USER_IDS=
# Comma-separated Discord channel IDs where the bot may answer (a DM uses the DM channel ID)
DISCORD_ALLOWED_CHANNEL_IDS=

# Enable a custom Base URL only (leave empty to use each provider's default)
AI_BASE_URL=

# Persistent system log file (default: logs/app-log.jsonl)
AI_WEB_LOG_FILE=logs/app-log.jsonl

# Personal llm-wiki vault shared by every agent (created and seeded on start;
# it is user data, so it stays out of Git and out of the deploy copy)
AI_WEB_WIKI_DIR=llm-wiki

# Default working folder for the agent's tools (defaults to the llm-wiki vault;
# set this to keep the tools in another folder while the wiki stays where it is)
AI_WEB_WORKSPACE_DIR=llm-wiki

# Device-pairing web auth (default: on) — set off only on a trusted network
# Create a Pairing Key on the server with: python app.py --pairing-key
AI_WEB_AUTH=on

# File that stores Pairing Key and paired-session hashes (must not be committed)
AI_WEB_AUTH_FILE=.app-auth.json

# Pairing Key lifetime (minutes) and paired-device session lifetime (days)
AI_WEB_PAIRING_TTL_MINUTES=30
AI_WEB_SESSION_DAYS=30

# Set to 1 only when a reverse proxy terminates TLS and the proxy sends X-Forwarded-Proto
# on every request and overwrites any value the client sent (never pass the client value through)
# so the cookie becomes Secure. Leave empty when serving HTTP directly on the machine/LAN.
AI_WEB_TRUST_PROXY=

# HTTPS directly from Flask (no extra Python package is needed; only openssl must be installed)
# Create a self-signed certificate on the server with: ./start_web.sh --make-cert <ip>, then set the paths below
AI_WEB_TLS_CERT=
AI_WEB_TLS_KEY=
# Use an automatically generated self-signed certificate (openssl, kept in certs/adhoc-*.pem and reused)
AI_WEB_TLS_ADHOC=


# Memory consolidation (background): Markdown vault + local SQLite index
AI_WEB_MEMORY_DIR=memory
AI_WEB_MEMORY_FILE=MEMORY.md
AI_WEB_DREAMS_FILE=DREAMS.md
AI_WEB_MEMORY_DB=.app-memory.db
# Optional sqlite-vec loadable extension (e.g. the android-aarch64 build).
# Leaving this unset or empty still looks for vendor/sqlite-vec/vec0.so; the
# Python fallback (vectors kept in SQLite) applies only when that file is absent.
AI_WEB_MEMORY_VEC_EXT=vendor/sqlite-vec/vec0.so
